{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": "src", // 设置基础目录为 src
    "paths": {
      "@/*": ["*"]  // @ 代表 src 目录
    },
    "esModuleInterop": true,  // 确保 TypeScript 处理默认导入
    "allowSyntheticDefaultImports": true  // 允许默认导入
  }
}
